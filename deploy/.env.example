# ===== 运行模式 =====
DEMO_MODE=true
APP_ENV=dev
SECRET_KEY=please-change-me

# ===== 服务 =====
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS=http://localhost:5173,http://localhost

# ===== 数据库 =====
# 默认 postgres；本地快速 DEMO 可改为 sqlite 跳过 PG 依赖
DB_DRIVER=postgres
DB_HOST=db
DB_PORT=5432
DB_NAME=mfgai
DB_USER=mfgai
DB_PASSWORD=change-me
SQLITE_PATH=./data/mfgai.db

# ===== 向量库 =====
VECTOR_DRIVER=pgvector
VECTOR_DIM=1024

# ===== 文件存储 =====
FILE_DRIVER=local
FILE_ROOT=./data/files

# ===== LLM =====
LLM_DRIVER=openai_compat
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60
LLM_MAX_RETRY=2

# ===== 向量化模型 =====
EMBED_DRIVER=openai_compat
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=bge-m3

# ===== 业务配置 =====
AUDIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=20
NL2SQL_MAX_ROWS=1000

# 行业包过滤：设为 manufacturing / government 时只加载对应行业模块；留空加载全部
INDUSTRY_PACKAGE=
