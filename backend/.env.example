# =====================================================================
# mfg-ai-base 后端配置示例
# 用法：cp .env.example .env，按注释修改后启动
# 注意：本文件可提交；真实 .env 已在 .gitignore 中，切勿提交真实密钥
# =====================================================================

# ===== 运行模式 =====
# true  = 演示模式（种子数据 + 剧本降级；§2.1 后仍需登录或访客链接）
# false = 生产模式（必须配置强 SECRET_KEY，初始密码随机并仅打印一次）
DEMO_MODE=true
APP_ENV=dev
# 必填（生产模式为空或弱值将拒绝启动）。生成命令：
#   python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=

# ===== 服务 =====
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=5173
# CORS 白名单（逗号分隔）；生产环境禁止使用 *，必须显式枚举前端来源
# 例：https://your-app.pages.dev,https://your-app.edgeone.app
CORS_ORIGINS=http://localhost:5173,http://localhost

# ===== 数据库 =====
# sqlite 开箱即用（演示/单机/免费部署推荐，审计与访客记录数据量极小）
# postgres 用于团队/容器化部署
DB_DRIVER=sqlite
DB_HOST=db
DB_PORT=5432
DB_NAME=mfgai
DB_USER=mfgai
DB_PASSWORD=change-me
SQLITE_PATH=./data/mfgai.db

# ===== 向量库（当前 BM25 为主，保持默认即可）=====
VECTOR_DRIVER=pgvector
VECTOR_DIM=1024

# ===== 文件存储 =====
FILE_DRIVER=local
FILE_ROOT=./data/files

# ===== LLM（OpenAI 兼容协议，如 DeepSeek）=====
# 留空时自动进入 §2.2 剧本降级模式：6 模块推荐问题仍可完整演示
LLM_DRIVER=openai_compat
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60
LLM_MAX_RETRY=2

# ===== 向量化模型（可留空，BM25 链路不依赖）=====
EMBED_DRIVER=openai_compat
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=bge-m3

# ===== 业务配置 =====
AUDIT_ENABLED=true
# 每 IP 每分钟请求上限（公网防刷，本地联调可适当放大）
RATE_LIMIT_PER_MINUTE=20
NL2SQL_MAX_ROWS=1000

# ===== 访客时效访问（§2.1）=====
GUEST_DEFAULT_HOURS=1       # 访客链接默认有效期（可选 1/6/24 小时）
GUEST_MAX_CALLS=30          # 每个访客链接默认调用次数上限
GUEST_RATE_PER_MINUTE=5     # 每个访客令牌每分钟 invoke 上限
GUEST_REAL_LLM_MAX=10       # 高级访客真实 LLM 配额默认值（超出自动降级剧本）

# 行业包过滤：留空=全部，manufacturing=制造业包，government=政务包
INDUSTRY_PACKAGE=
